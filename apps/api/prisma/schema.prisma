// 山野商城 · 数据模型（技术方案 v1.0 §05）
// 约定：金额一律整数分（_cents / *Cents），时间一律 timestamptz

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ON_SALE
  OFF_SHELF
  SOLD_OUT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  REFUNDING
  REFUNDED
  CLOSED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AfterSaleType {
  REFUND_ONLY
  RETURN_REFUND
}

enum AfterSaleStatus {
  APPLIED
  WAIT_BUYER_SHIP
  WAIT_SELLER_RECEIVE
  REFUNDING
  COMPLETED
  REJECTED
}

enum CouponType {
  THRESHOLD
  NO_THRESHOLD
}

enum CouponClaimStatus {
  UNUSED
  USED
  EXPIRED
}

enum ReviewStatus {
  PENDING
  SHOWN
  HIDDEN
}

enum AdminUserKind {
  PC
  STORE
}

enum ProductChannel {
  NORMAL
  POINTS
}

model Product {
  id              String        @id @default(cuid())
  title           String
  subtitle        String?
  categoryId      String
  /// 渠道：NORMAL 普通商城；POINTS 积分商城（不进入普通列表/购物车/搜索）
  channel         ProductChannel @default(NORMAL)
  /// 每人限兑数量；0 表示不限
  pointsLimitPerUser Int        @default(0)
  /// 标题 + 副标题 + 分类 + 标签 + 拼音全拼/首字母（服务端生成）
  searchText      String        @default("")
  status          ProductStatus @default(OFF_SHELF)
  /// 主图（首张，供列表/购物车/订单快照使用）
  mainImageKey    String?
  /// 主图轮播（有序）；mainImageKey 始终与首张保持一致
  mainImageKeys   String[]      @default([])
  /// 详情图片（有序，详情页按顺序上下排列）
  detailImageKeys String[]      @default([])
  detail          String?
  priceMinCents   Int           @default(0)
  priceMaxCents   Int           @default(0)
  soldCount       Int           @default(0)
  sort            Int           @default(0)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  category Category     @relation(fields: [categoryId], references: [id])
  skus     Sku[]
  tags     ProductTag[]
  circlePostProducts CirclePostProduct[]

  @@index([categoryId, status])
  @@index([channel, status])
  @@index([sort])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ProductTag {
  id        String   @id @default(cuid())
  name      String   @unique
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// 搜索日志：热词与无结果词由日志自动聚合，不提供人工维护
model SearchLog {
  id          String   @id @default(cuid())
  /// 归一化关键词：去首尾空格、转小写、最长 50 字
  keyword     String
  resultCount Int      @default(0)
  /// 登录用户；匿名搜索为空
  userId      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([keyword, createdAt])
  @@index([resultCount, createdAt])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  /// 分类图标，素材库 key；为空时小程序取该分类首个商品图兜底
  iconKey  String?
  parentId String?
  sort     Int        @default(0)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, sort])
}

model Sku {
  id          String        @id @default(cuid())
  productId   String
  code        String        @unique
  specJson    Json
  priceCents  Int
  originCents Int?
  /// 积分兑换所需积分（每件）；null 表示该规格不参与兑换
  pointsCost       Int?
  /// 积分 + 钱时的加价金额（分/件），纯积分时为 0
  pointsMoneyCents Int   @default(0)
  stock       Int           @default(0)
  reserved    Int           @default(0)
  status      ProductStatus @default(ON_SALE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  product    Product      @relation(fields: [productId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
  seckills   SeckillSku[]
  storeSkus  StoreSku[]

  @@index([productId])
  @@index([status])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  skuId     String
  quantity  Int
  checked   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])
  sku  Sku  @relation(fields: [skuId], references: [id])

  @@unique([userId, skuId])
  @@index([userId])
}

model Order {
  id             String      @id @default(cuid())
  orderNo        String      @unique
  userId         String
  status         OrderStatus @default(PENDING_PAYMENT)
  /// NORMAL 普通订单；POINTS 积分兑换订单
  orderType      String      @default("NORMAL")
  /// 积分兑换消耗的积分
  pointsUsed     Int         @default(0)
  version        Int         @default(0)
  /**
   * 客户端幂等键：同一用户重复提交返回同一订单
   */
  idempotencyKey String?

  // 金额快照（整数分）：商品 → 会员折扣 → 优惠券 → 满减 → 运费 → 应付
  goodsCents          Int
  memberDiscountCents Int @default(0)
  couponCents         Int @default(0)
  fullReductionCents  Int @default(0)
  freightCents        Int @default(0)
  payableCents        Int
  refundedCents       Int @default(0)

  // 履约方式：EXPRESS（默认，兼容历史订单）| DELIVERY | PICKUP
  fulfillmentType     String    @default("EXPRESS")
  storeId             String?
  /// 自提核销码（支付成功后生成，全局唯一）
  pickupCode          String?   @unique
  pickupAt            DateTime? @db.Timestamptz(3)
  pickupCodeExpiresAt DateTime? @db.Timestamptz(3)
  /// 同城配送时段，如 "10:00-12:00"；按门店+时段统计容量
  deliverySlot        String?

  addressSnapshot Json
  remark          String?
  adminRemark     String?
  previousStatus  OrderStatus?

  payDeadlineAt DateTime  @db.Timestamptz(3)
  paidAt        DateTime? @db.Timestamptz(3)
  shippedAt     DateTime? @db.Timestamptz(3)
  completedAt   DateTime? @db.Timestamptz(3)
  closedAt      DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id])
  store              Store?              @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           Payment[]
  shipment           Shipment?
  delivery           Delivery?
  afterSales         AfterSale[]
  reviews            Review[]
  pickupVerification PickupVerification?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@index([fulfillmentType, status])
  @@index([storeId, deliverySlot])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  skuId         String
  title         String
  specText      String
  imageKey      String?
  priceCents    Int
  quantity      Int
  subtotalCents Int
  /// 积分兑换单：该行每件消耗积分快照
  pointsCost    Int     @default(0)
  /**
   * 分摊后的行实付（不含运费）：退款上限与默认退款额以它为准
   */
  paidCents     Int     @default(0)
  refundedCents Int     @default(0)
  /**
   * 秒杀行：价格取秒杀价，不参与会员折扣/券/满减
   */
  isSeckill     Boolean @default(false)
  seckillId     String?

  order Order @relation(fields: [orderId], references: [id])
  sku   Sku   @relation(fields: [skuId], references: [id])

  afterSale AfterSale?
  review    Review?

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  provider      String
  outTradeNo    String        @unique
  transactionId String?       @unique
  amountCents   Int
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?     @db.Timestamptz(3)
  rawCallback   Json?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Shipment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  expressCode String
  expressName String
  trackingNo  String
  traceJson   Json?
  shippedAt   DateTime @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])
}

// 同城配送单：支付成功后创建，一单一配送；门店接单与送达推进状态
model Delivery {
  id           String    @id @default(cuid())
  orderId      String    @unique
  storeId      String
  /// PENDING | ACCEPTED | DELIVERED | CANCELLED
  status       String    @default("PENDING")
  courierName  String?
  courierPhone String?
  acceptedAt   DateTime? @db.Timestamptz(3)
  deliveredAt  DateTime? @db.Timestamptz(3)
  remark       String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, status])
  @@index([status, createdAt])
}

model AfterSale {
  id                  String          @id @default(cuid())
  afterSaleNo         String          @unique
  orderId             String
  orderItemId         String          @unique
  userId              String
  type                AfterSaleType
  reason              String
  description         String?
  evidenceJson        Json?
  refundCents         Int
  status              AfterSaleStatus @default(APPLIED)
  rejectReason        String?
  buyerTrackingNo     String?
  /**
   * 申请前的订单状态，部分退款后用于恢复
   */
  previousOrderStatus OrderStatus?
  finishedAt          DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  refund    Refund?

  @@index([status, createdAt])
  @@index([userId])
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

model Refund {
  id            String       @id @default(cuid())
  refundNo      String       @unique
  afterSaleId   String       @unique
  orderId       String
  amountCents   Int
  status        RefundStatus @default(PENDING)
  provider      String       @default("mock")
  /**
   * 渠道退款单号：幂等依据
   */
  transactionId String?      @unique
  failReason    String?
  rawResponse   Json?
  /// 渠道侧退款状态：PROCESSING / SUCCESS / ABNORMAL / CLOSED
  channelStatus String?
  lastQueriedAt DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  refundedAt    DateTime?    @db.Timestamptz(3)

  afterSale AfterSale @relation(fields: [afterSaleId], references: [id])

  @@index([orderId])
  @@index([status])
}

// 订阅消息 outbox：业务事务只写日志，异步发送并可重试
model NotificationLog {
  id           String    @id @default(cuid())
  /// 去重键：场景 + 业务单号，同一业务事件只入队一次
  dedupeKey    String    @unique
  scene        String
  templateId   String
  userId       String
  openid       String?
  page         String?
  dataJson     Json
  /// PENDING | SENT | SKIPPED | FAILED
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  nextRetryAt  DateTime? @db.Timestamptz(3)
  error        String?
  responseJson Json?
  sentAt       DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, nextRetryAt])
  @@index([scene, createdAt])
}

model Coupon {
  id             String     @id @default(cuid())
  name           String
  type           CouponType @default(THRESHOLD)
  thresholdCents Int        @default(0)
  faceValueCents Int
  total          Int
  claimed        Int        @default(0)
  perLimit       Int        @default(1)
  channel        String     @default("MINIAPP")
  startAt        DateTime   @db.Timestamptz(3)
  endAt          DateTime   @db.Timestamptz(3)
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  claims CouponClaim[]

  @@index([enabled, startAt, endAt])
}

model CouponClaim {
  id        String            @id @default(cuid())
  couponId  String
  userId    String
  status    CouponClaimStatus @default(UNUSED)
  orderId   String?
  usedAt    DateTime?         @db.Timestamptz(3)
  expiresAt DateTime          @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([couponId])
}

model User {
  id              String   @id @default(cuid())
  openid          String   @unique
  nickname        String?
  avatarKey       String?
  phone           String?
  levelId         String?
  totalSpentCents Int      @default(0)
  points          Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  level              MemberLevel?        @relation(fields: [levelId], references: [id])
  addresses          Address[]
  orders             Order[]
  cartItems          CartItem[]
  couponClaims       CouponClaim[]
  pointsLedger       PointsLedger[]
  memberCards        MemberCard[]
  rechargeOrders     RechargeOrder[]
  storedValueAccount StoredValueAccount?
  tags               UserTagLink[]
  managedStore       Store?
  consents           UserConsent[]
  pointsSignIns      PointsSignIn[]
  pointsShareDailies PointsShareDaily[]
  circlePosts            CirclePost[]
  circleComments         CircleComment[]
  circleLikes            CircleLike[]
  circleFavorites        CircleFavorite[]
  circleFollowing        CircleFollow[]         @relation("CircleFollowFollower")
  circleFollowers        CircleFollow[]         @relation("CircleFollowFollowing")
  circleNotifications    CircleNotification[]   @relation("CircleNotificationUser")
  circleActorNotifications CircleNotification[] @relation("CircleNotificationActor")
  circleReports          CircleReport[]

  @@index([levelId])
}

/// 积分规则（单例）：消费、签到、分享的发放口径；不参与订单抵扣
model PointsConfig {
  id                      String   @id @default("singleton")
  /// 消费多少元获得 1 积分
  yuanPerPoint            Int      @default(1)
  /// 每日签到基础积分，0 表示关闭签到
  signInPoints            Int      @default(0)
  /// 连续签到天数阈值，0 表示不做连续奖励
  signInStreakDays        Int      @default(0)
  /// 连续奖励类型：POINTS | COUPON
  signInStreakBonusType   String   @default("POINTS")
  /// 连续奖励积分（POINTS）
  signInStreakBonusPoints Int      @default(0)
  /// 连续奖励优惠券（COUPON）
  signInStreakCouponId    String?
  /// 分享赠送积分，0 表示关闭
  sharePoints             Int      @default(0)
  /// 分享每天最多计入次数，0 表示关闭
  shareDailyLimit         Int      @default(0)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
}

/// 每日签到记录：用户 + 日期唯一，用于连签与防重复
model PointsSignIn {
  id                 String   @id @default(cuid())
  userId             String
  /// Asia/Shanghai 的 YYYY-MM-DD
  date               String
  points             Int      @default(0)
  streak             Int      @default(1)
  bonusPoints        Int      @default(0)
  bonusCouponClaimId String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

/// 分享奖励每日计数：用户 + 日期唯一
model PointsShareDaily {
  id        String   @id @default(cuid())
  userId    String
  date      String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// 协议同意留痕：用户 + 类型 + 版本唯一
model UserConsent {
  id        String   @id @default(cuid())
  userId    String
  /// USER_AGREEMENT | PRIVACY
  type      String
  version   String
  agreedAt  DateTime @default(now()) @db.Timestamptz(3)
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, version])
  @@index([userId])
}

/// 用户标签：仅支持两级（parentId 为空为一级标签）
model UserTag {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  parent   UserTag?      @relation("UserTagTree", fields: [parentId], references: [id], onDelete: Cascade)
  children UserTag[]     @relation("UserTagTree")
  users    UserTagLink[]

  @@index([parentId, sort])
}

/// 用户与标签的多对多关系
model UserTagLink {
  userId    String
  tagId     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  UserTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  receiver  String
  phone     String
  region    String
  detail    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Review {
  id          String       @id @default(cuid())
  orderItemId String       @unique
  orderId     String
  userId      String
  rating      Int
  content     String?
  imagesJson  Json?
  anonymous   Boolean      @default(false)
  status      ReviewStatus @default(PENDING)
  reply       String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@index([status, createdAt])
}

// 积分仅记录发放与扣回，不参与订单抵扣（已确认决策 D4）
model PointsLedger {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  source       String
  /**
   * 流水说明：订单支付、退款扣回、后台手动调整等
   */
  reason       String?
  orderId      String?
  balanceAfter Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// 积分商城每人限兑计数：下单占用，取消/退款回补
model PointsMallQuota {
  id        String   @id @default(cuid())
  userId    String
  productId String
  usedQty   Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, productId])
  @@index([productId])
}

model MemberLevel {
  id             String @id @default(cuid())
  name           String
  thresholdCents Int
  discountRate   Float  @default(1)
  sort           Int    @default(0)

  users User[]
}

// 付费会员卡方案：折扣与等级折扣取最优，不叠加
model MemberCardPlan {
  id           String   @id @default(cuid())
  name         String
  priceCents   Int
  durationDays Int
  discountRate Float    @default(1)
  pointsRate   Float    @default(1)
  freeShipping Boolean  @default(false)
  enabled      Boolean  @default(true)
  sort         Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

// 用户持有的会员卡：权益快照，避免方案修改影响已购卡
model MemberCard {
  id           String   @id @default(cuid())
  userId       String
  planId       String
  planName     String
  discountRate Float
  pointsRate   Float
  freeShipping Boolean
  startAt      DateTime @db.Timestamptz(3)
  expireAt     DateTime @db.Timestamptz(3)
  /// ACTIVE | REPLACED | EXPIRED
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status, expireAt])
}

// 储值充值套餐
model RechargePlan {
  id          String   @id @default(cuid())
  amountCents Int
  bonusCents  Int      @default(0)
  enabled     Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model StoredValueAccount {
  id                  String   @id @default(cuid())
  userId              String   @unique
  balanceCents        Int      @default(0)
  totalRechargedCents Int      @default(0)
  totalConsumedCents  Int      @default(0)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])
}

// 储值流水：所有资金变动必须留痕
model StoredValueLedger {
  id           String   @id @default(cuid())
  userId       String
  deltaCents   Int
  balanceAfter Int
  /// RECHARGE | CARD_PURCHASE | BALANCE_PAY | REFUND | ADMIN_ADJUST | ROLLBACK
  type         String
  refType      String?
  refId        String?
  remark       String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

// 充值记录：本地暂以 mock 渠道直接入账，接入真实支付后改为回调入账
model RechargeOrder {
  id          String    @id @default(cuid())
  rechargeNo  String    @unique
  userId      String
  planId      String?
  amountCents Int
  bonusCents  Int       @default(0)
  provider    String    @default("mock")
  status      String    @default("PAID")
  paidAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model AdminRoleDef {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  permissions String[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  users AdminUser[]
}

model AdminUser {
  id           String        @id @default(cuid())
  account      String        @unique
  passwordHash String
  displayName  String
  kind         AdminUserKind @default(PC)
  /// 超级管理员：跳过权限校验，仅用于兜底
  isSuper      Boolean       @default(false)
  roleId       String?
  role         AdminRoleDef? @relation(fields: [roleId], references: [id])
  status       String        @default("ACTIVE")
  failCount    Int           @default(0)
  lockedUntil  DateTime?     @db.Timestamptz(3)
  lastLoginAt  DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  logs        OperationLog[]
  adminStores AdminStore[]

  @@index([roleId])
}

model OperationLog {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String
  action     String
  targetType String
  targetId   String
  beforeJson Json?
  afterJson  Json?
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor AdminUser @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([targetType, targetId])
}

// 单商家自营：只有一行配置，无 merchant / settlement 表
model ShopConfig {
  id                 String   @id @default("singleton")
  shopName           String   @default("山野")
  intro              String?
  logoKey            String?
  servicePhone       String?
  /// 对外联系方式：邮箱 / 微信 / 服务时间 / 公司地址
  serviceEmail       String?
  serviceWechat      String?
  serviceHours       String?
  companyAddress     String?
  /// 经营主体与备案信息（小程序「关于我们」展示）
  companyName        String?
  creditCode         String?
  icpNumber          String?
  icpUrl             String?
  policeNumber       String?
  policeUrl          String?
  /// 对外官方商城 / H5 地址（业务域名仍由集成配置维护）
  officialSiteUrl    String?
  freeThresholdCents Int      @default(9900)
  flatFreightCents   Int      @default(1000)
  payTimeoutMinutes  Int      @default(15)
  afterSaleDays      Int      @default(7)
  autoConfirmDays    Int      @default(10)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

model ShippingRegionException {
  id           String   @id @default(cuid())
  regionName   String
  freightCents Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

// 素材库：图片落本机磁盘（UPLOAD_DIR/assets），一级文件夹做逻辑分类
model AssetFolder {
  id        String   @id @default(cuid())
  name      String   @unique
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  assets Asset[]
}

model Asset {
  id           String   @id @default(cuid())
  /// 业务引用键：上传素材为 /api/media/assets/<storageKey>，历史静态素材为相对 key
  key          String   @unique
  url          String
  /// 磁盘相对路径（如 2026/11/xxx.jpg），历史外链素材为空
  storageKey   String?
  /// 上传时的原始文件名，仅用于检索与展示
  originalName String?
  size         Int      @default(0)
  mimeType     String?
  folderId     String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  folder AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
}

// 对外集成参数：小程序登录、微信支付、订阅消息、业务域名
// AppSecret 直接存文本（接口不回传）；支付密钥/证书存服务端文件路径
model IntegrationConfig {
  id                      String   @id @default("singleton")
  // 小程序登录
  miniappAppId            String?
  miniappAppSecret        String?
  // 小程序代码上传密钥（miniprogram-ci 使用）
  miniappUploadKeyFile    String?
  miniappUploadKeyName    String?
  // 支付渠道与微信支付参数
  paymentProvider         String   @default("mock")
  wechatPayMchId          String?
  wechatPayCertSerial     String?
  wechatPayNotifyUrl      String?
  wechatPayApiV3KeyFile   String?
  wechatPayApiV3KeyName   String?
  wechatPayPrivateKeyFile String?
  wechatPayPrivateKeyName String?
  // 微信支付公钥模式（新商户）：公钥 ID + 公钥文件；平台证书模式留空
  wechatPayPublicKeyId    String?
  wechatPayPublicKeyFile  String?
  wechatPayPublicKeyName  String?
  // 订阅消息模板：{ orderPaid, orderShipped, refundResult }
  subscribeTemplateIds    Json?
  // 模板字段映射：{ orderPaid: { "character_string1": "orderNo" }, ... }
  subscribeTemplateFields Json?
  // 小程序业务域名 / 服务端 API 地址
  apiBaseUrl              String?
  businessDomain          String?
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
}

// 小程序发布记录：服务器构建 → miniprogram-ci 上传开发版 → 生成体验版二维码
// 审核与发布在微信公众平台完成，这里记录结果供团队追踪
model MiniappRelease {
  id           String   @id @default(cuid())
  version      String
  description  String
  // BUILDING | UPLOADED | FAILED | RELEASED
  status       String   @default("BUILDING")
  qrCodePath   String?
  size         Int      @default(0)
  log          String?  @db.Text
  operatorId   String?
  operatorName String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}

// 物流公司字典：批量发货选择物流公司，code 对外展示与导入使用
model ExpressCompany {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// 首页弹窗广告：每条每天最多展示一次，多条按优先级依次弹出
model PopupAd {
  id        String    @id @default(cuid())
  name      String
  imageKey  String
  alt       String?
  /// 统一链接：{ type, value }
  link      Json      @default("{}")
  priority  Int       @default(0)
  enabled   Boolean   @default(true)
  startAt   DateTime? @db.Timestamptz(3)
  endAt     DateTime? @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([enabled, priority])
  @@index([deletedAt])
}

// 微页面：可视化装修后的页面，草稿与发布快照分离，线上只读发布快照
model MicroPage {
  id                  String    @id @default(cuid())
  /// 访问标识：home 为系统首页；小程序路径 /pages/micro/index?code=xxx
  code                String    @unique
  title               String
  /// DRAFT | PUBLISHED
  status              String    @default("DRAFT")
  isHome              Boolean   @default(false)
  /// 草稿组件文档
  components          Json      @default("[]")
  /// 已发布组件快照
  publishedComponents Json?
  /// 上一版发布快照（用于回滚）
  previousComponents Json?
  /// 页面设置：shareTitle / shareDesc / shareImageKey / bgColor / navStyle / allowShare
  settings            Json      @default("{}")
  publishedSettings   Json?
  previousSettings    Json?
  schemaVersion       Int       @default(1)
  version             Int       @default(0)
  publishedAt         DateTime? @db.Timestamptz(3)
  publishedBy         String?
  updatedBy           String?
  deletedAt           DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, isHome])
  @@index([deletedAt])
}

// 底部导航（单例）：条目由后台配置，小程序自绘 TabBar 读取
model ShopTabbar {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(true)
  /// { background, color, selectedColor, borderTop }
  style     Json     @default("{}")
  /// [{ key, text, iconKey, activeIconKey, link }]
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// 营销活动：满减（FULL_REDUCTION）与限时秒杀（SECKILL）
model Promotion {
  id             String   @id @default(cuid())
  name           String
  type           String
  enabled        Boolean  @default(true)
  startAt        DateTime @db.Timestamptz(3)
  endAt          DateTime @db.Timestamptz(3)
  /// 满减门槛（仅 FULL_REDUCTION）
  thresholdCents Int?
  /// 满减金额（仅 FULL_REDUCTION）
  discountCents  Int?
  /// 满减范围：ALL | CATEGORY | PRODUCT
  scopeType      String   @default("ALL")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  scopes PromotionScope[]
  skus   SeckillSku[]

  @@index([type, enabled, startAt, endAt])
}

model PromotionScope {
  id          String @id @default(cuid())
  promotionId String
  targetType  String
  targetId    String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, targetType, targetId])
  @@index([promotionId])
}

model SeckillSku {
  id                String   @id @default(cuid())
  promotionId       String
  skuId             String
  seckillPriceCents Int
  stock             Int
  sold              Int      @default(0)
  limitPerUser      Int      @default(1)
  sort              Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  sku       Sku       @relation(fields: [skuId], references: [id])

  @@unique([promotionId, skuId])
  @@index([skuId])
}

// 轻量多门店：门店是自提与同城配送的履约主体
model Store {
  id                         String   @id @default(cuid())
  code                       String   @unique
  name                       String
  phone                      String?
  /// 门店 Logo（素材库 key）
  logoKey                    String?
  region                     String
  address                    String
  /// 仅用于展示，不做地图距离计算
  lat                        Float?
  lng                        Float?
  /// 营业时间：{ "mon": [["09:00","18:00"]], ... }
  businessHours              Json     @default("{}")
  pickupEnabled              Boolean  @default(false)
  deliveryEnabled            Boolean  @default(false)
  deliveryFeeCents           Int      @default(0)
  freeDeliveryThresholdCents Int      @default(0)
  /// 配送时段：["10:00-12:00", ...]
  deliverySlots              Json     @default("[]")
  /// 每日截单时间，如 "18:00"
  deliveryCutoff             String?
  /// 每时段最大单量，0 表示不限
  maxOrdersPerSlot           Int      @default(0)
  /// 自提支付后未核销自动完成天数
  pickupCompleteDays         Int      @default(7)
  notice                     String?
  status                     String   @default("ACTIVE")
  sort                       Int      @default(0)
  /// 临时打烊：截止时间之前不接受新订单（为空表示正常营业）
  temporarilyClosedUntil     DateTime? @db.Timestamptz(3)
  /// 临时打烊原因，展示在门店中心
  temporaryClosureNote       String?
  /// 关联会员（小程序 User）：绑定后该会员在小程序可见「门店中心」
  managerUserId              String?  @unique
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  manager             User?               @relation(fields: [managerUserId], references: [id], onDelete: SetNull)
  adminStores         AdminStore[]
  skus                StoreSku[]
  deliveryRegions     StoreDeliveryRegion[]
  stockLogs           StoreStockLog[]
  orders              Order[]
  pickupVerifications PickupVerification[]
  deliveries          Delivery[]

  @@index([status, sort])
}

// 管理员与门店多对多：一个门店账号可管理多个门店
// 自提核销记录：手动核销或超时自动完成，一单一条
model PickupVerification {
  id         String   @id @default(cuid())
  orderId    String   @unique
  storeId    String
  /// CODE | QR | AUTO
  method     String
  verifiedBy String?
  verifiedAt DateTime @default(now()) @db.Timestamptz(3)
  note       String?

  order Order @relation(fields: [orderId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, verifiedAt])
}

model AdminStore {
  id          String @id @default(cuid())
  adminUserId String
  storeId     String

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, storeId])
  @@index([storeId])
}

// 门店可售库存：与总部仓 Sku.stock 隔离，仅服务自提与同城配送
model StoreSku {
  id          String        @id @default(cuid())
  storeId     String
  skuId       String
  stock       Int           @default(0)
  reserved    Int           @default(0)
  safetyStock Int           @default(0)
  status      ProductStatus @default(ON_SALE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([storeId, skuId])
  @@index([skuId])
}

// 门店配送范围：区县白名单，按收货地址 region 匹配
model StoreDeliveryRegion {
  id         String @id @default(cuid())
  storeId    String
  regionName String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, regionName])
  @@index([regionName])
}

// 门店库存流水：调整、下单预占、取消释放、退款回滚均留痕
model StoreStockLog {
  id          String   @id @default(cuid())
  storeId     String
  skuId       String
  delta       Int
  beforeStock Int
  afterStock  Int
  /// ADJUST | ORDER_RESERVE | ORDER_RELEASE | REFUND | RESTOCK
  reason      String
  orderId     String?
  operatorId  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([skuId])
}

// ==================== 圈子（品牌内容社区） ====================

enum CirclePostStatus {
  PENDING // 待审核
  PUBLISHED
  REJECTED // 审核拒绝
  HIDDEN // 违规或作者删除后隐藏
}

enum CircleReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

/// 圈子类目：平台维护，帖子必选其一
model CircleCategory {
  id        String   @id @default(cuid())
  name      String
  iconKey   String?
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  posts  CirclePost[]
  topics CircleTopic[]

  @@index([enabled, sort])
}

/// 圈子话题：平台创建，用于内容聚合与运营活动
model CircleTopic {
  id          String    @id @default(cuid())
  name        String
  description String?
  coverKey    String?
  categoryId  String?
  startAt     DateTime? @db.Timestamptz(3)
  endAt       DateTime? @db.Timestamptz(3)
  pinned      Boolean   @default(false)
  enabled     Boolean   @default(true)
  sort        Int       @default(0)
  /// 已发布帖子数（冗余计数，审核通过 +1）
  postCount   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  category CircleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  posts    CirclePostTopic[]

  @@index([enabled, pinned, sort])
  @@index([categoryId])
}

/// 用户发布的图文内容
model CirclePost {
  id            String           @id @default(cuid())
  userId        String
  categoryId    String
  content       String           @db.Text
  /// [{ key, width, height }]，1~9 张
  mediaJson     Json
  status        CirclePostStatus @default(PUBLISHED)
  auditNote     String?
  auditedBy     String?
  auditedAt     DateTime?        @db.Timestamptz(3)
  pinned        Boolean          @default(false)
  featured      Boolean          @default(false)
  likeCount     Int              @default(0)
  commentCount  Int              @default(0)
  favoriteCount Int              @default(0)
  viewCount     Int              @default(0)
  /// 发帖积分发放时间：为空表示尚未奖励，避免重复发放
  rewardedAt    DateTime?        @db.Timestamptz(3)
  publishedAt   DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category CircleCategory     @relation(fields: [categoryId], references: [id])
  topics   CirclePostTopic[]
  products CirclePostProduct[]
  comments  CircleComment[]
  likes     CircleLike[]
  favorites CircleFavorite[]

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([userId, createdAt])
}

model CirclePostTopic {
  postId  String
  topicId String
  sort    Int    @default(0)

  post  CirclePost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  topic CircleTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([postId, topicId])
  @@index([topicId])
}

model CirclePostProduct {
  postId    String
  productId String
  sort      Int    @default(0)

  post    CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([productId])
}

model CircleComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  /// 一级回复指向的评论
  parentId  String?
  content   String   @db.Text
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  post CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

model CircleLike {
  postId    String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  post CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model CircleFavorite {
  postId    String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  post CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model CircleFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  follower  User @relation("CircleFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("CircleFollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model CircleReport {
  id         String             @id @default(cuid())
  /// POST | COMMENT | USER
  targetType String
  targetId   String
  reporterId String
  /// 广告引流 | 违法违规 | 色情低俗 | 人身攻击 | 虚假信息 | 其他
  reason     String
  detail     String?
  status     CircleReportStatus @default(PENDING)
  handledBy  String?
  handledAt  DateTime?          @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model CircleNotification {
  id        String   @id @default(cuid())
  userId    String
  /// LIKE | COMMENT | REPLY | FOLLOW | SYSTEM
  type      String
  actorId   String?
  postId    String?
  commentId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user  User  @relation("CircleNotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("CircleNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
}

/// 圈子设置（单例）
model CircleSetting {
  id                   String   @id @default("singleton")
  enabled              Boolean  @default(true)
  /// HYBRID：机审后发布，命中风险自动隐藏待审；REVIEW：先审后发
  auditMode            String   @default("HYBRID")
  dailyPostLimit       Int      @default(5)
  dailyCommentLimit    Int      @default(30)
  postPoints           Int      @default(10)
  postPointsDailyLimit Int      @default(1)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
}

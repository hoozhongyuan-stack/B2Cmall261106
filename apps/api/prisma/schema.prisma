// 山野商城 · 数据模型（技术方案 v1.0 §05）
// 约定：金额一律整数分（_cents / *Cents），时间一律 timestamptz

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ON_SALE
  OFF_SHELF
  SOLD_OUT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  REFUNDING
  REFUNDED
  CLOSED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AfterSaleType {
  REFUND_ONLY
  RETURN_REFUND
}

enum AfterSaleStatus {
  APPLIED
  WAIT_BUYER_SHIP
  WAIT_SELLER_RECEIVE
  REFUNDING
  COMPLETED
  REJECTED
}

enum CouponType {
  THRESHOLD
  NO_THRESHOLD
}

enum CouponClaimStatus {
  UNUSED
  USED
  EXPIRED
}

enum ReviewStatus {
  PENDING
  SHOWN
  HIDDEN
}

enum AdminRole {
  SUPER
  OPS
  CS
  WMS
}

model Product {
  id           String        @id @default(cuid())
  title        String
  subtitle     String?
  categoryId   String
  status       ProductStatus @default(OFF_SHELF)
  mainImageKey String?
  detail       String?
  priceMinCents Int          @default(0)
  priceMaxCents Int          @default(0)
  soldCount    Int           @default(0)
  sort         Int           @default(0)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  category Category  @relation(fields: [categoryId], references: [id])
  skus     Sku[]
  tags     ProductTag[]

  @@index([categoryId, status])
  @@index([sort])
}

model ProductTag {
  id        String  @id @default(cuid())
  name      String  @unique
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Category {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  sort      Int      @default(0)
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId, sort])
}

model Sku {
  id          String @id @default(cuid())
  productId   String
  code        String @unique
  specJson    Json
  priceCents  Int
  originCents Int?
  stock       Int    @default(0)
  reserved    Int    @default(0)
  status      ProductStatus @default(ON_SALE)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  product     Product     @relation(fields: [productId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([productId])
  @@index([status])
}

model CartItem {
  id       String @id @default(cuid())
  userId   String
  skuId    String
  quantity Int
  checked  Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])
  sku  Sku  @relation(fields: [skuId], references: [id])

  @@unique([userId, skuId])
  @@index([userId])
}

model Order {
  id                  String      @id @default(cuid())
  orderNo             String      @unique
  userId              String
  status              OrderStatus @default(PENDING_PAYMENT)
  version             Int         @default(0)
  /** 客户端幂等键：同一用户重复提交返回同一订单 */
  idempotencyKey      String?

  // 金额快照（整数分）：商品 → 会员折扣 → 优惠券 → 运费 → 应付
  goodsCents          Int
  memberDiscountCents Int         @default(0)
  couponCents         Int         @default(0)
  freightCents        Int         @default(0)
  payableCents        Int
  refundedCents       Int         @default(0)

  addressSnapshot     Json
  remark              String?
  adminRemark         String?
  previousStatus      OrderStatus?

  payDeadlineAt       DateTime    @db.Timestamptz(3)
  paidAt              DateTime?   @db.Timestamptz(3)
  shippedAt           DateTime?   @db.Timestamptz(3)
  completedAt         DateTime?   @db.Timestamptz(3)
  closedAt            DateTime?   @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  shipment  Shipment?
  afterSales AfterSale[]
  reviews   Review[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@unique([userId, idempotencyKey])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  skuId       String
  title       String
  specText    String
  imageKey    String?
  priceCents  Int
  quantity    Int
  subtotalCents Int
  /** 分摊后的行实付（不含运费）：退款上限与默认退款额以它为准 */
  paidCents   Int @default(0)
  refundedCents Int @default(0)

  order Order @relation(fields: [orderId], references: [id])
  sku   Sku   @relation(fields: [skuId], references: [id])

  afterSale AfterSale?
  review    Review?

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  provider      String
  outTradeNo    String        @unique
  transactionId String?       @unique
  amountCents   Int
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?     @db.Timestamptz(3)
  rawCallback   Json?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Shipment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  expressCode String
  expressName String
  trackingNo  String
  traceJson   Json?
  shippedAt   DateTime @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])
}

model AfterSale {
  id             String          @id @default(cuid())
  afterSaleNo    String          @unique
  orderId        String
  orderItemId    String          @unique
  userId         String
  type           AfterSaleType
  reason         String
  description    String?
  evidenceJson   Json?
  refundCents    Int
  status         AfterSaleStatus @default(APPLIED)
  rejectReason   String?
  buyerTrackingNo String?
  /** 申请前的订单状态，部分退款后用于恢复 */
  previousOrderStatus OrderStatus?
  finishedAt     DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  refund    Refund?

  @@index([status, createdAt])
  @@index([userId])
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

model Refund {
  id            String       @id @default(cuid())
  refundNo      String       @unique
  afterSaleId   String       @unique
  orderId       String
  amountCents   Int
  status        RefundStatus @default(PENDING)
  provider      String       @default("mock")
  /** 渠道退款单号：幂等依据 */
  transactionId String?      @unique
  failReason    String?
  rawResponse   Json?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  refundedAt    DateTime?    @db.Timestamptz(3)

  afterSale AfterSale @relation(fields: [afterSaleId], references: [id])

  @@index([orderId])
  @@index([status])
}

model Coupon {
  id               String     @id @default(cuid())
  name             String
  type             CouponType @default(THRESHOLD)
  thresholdCents   Int        @default(0)
  faceValueCents   Int
  total            Int
  claimed          Int        @default(0)
  perLimit         Int        @default(1)
  channel          String     @default("MINIAPP")
  startAt          DateTime   @db.Timestamptz(3)
  endAt            DateTime   @db.Timestamptz(3)
  enabled          Boolean    @default(true)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)

  claims CouponClaim[]

  @@index([enabled, startAt, endAt])
}

model CouponClaim {
  id        String            @id @default(cuid())
  couponId  String
  userId    String
  status    CouponClaimStatus @default(UNUSED)
  orderId   String?
  usedAt    DateTime?         @db.Timestamptz(3)
  expiresAt DateTime          @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([couponId])
}

model User {
  id            String   @id @default(cuid())
  openid        String   @unique
  nickname      String?
  avatarKey     String?
  phone         String?
  levelId       String?
  totalSpentCents Int    @default(0)
  points        Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  level       MemberLevel?  @relation(fields: [levelId], references: [id])
  addresses   Address[]
  orders      Order[]
  cartItems   CartItem[]
  couponClaims CouponClaim[]
  pointsLedger PointsLedger[]

  @@index([levelId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  receiver  String
  phone     String
  region    String
  detail    String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Review {
  id          String       @id @default(cuid())
  orderItemId String       @unique
  orderId     String
  userId      String
  rating      Int
  content     String?
  imagesJson  Json?
  anonymous   Boolean      @default(false)
  status      ReviewStatus @default(PENDING)
  reply       String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@index([status, createdAt])
}

// 积分仅记录发放与扣回，不参与订单抵扣（已确认决策 D4）
model PointsLedger {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  source       String
  /** 流水说明：订单支付、退款扣回、后台手动调整等 */
  reason       String?
  orderId      String?
  balanceAfter Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model MemberLevel {
  id             String @id @default(cuid())
  name           String
  thresholdCents Int
  discountRate   Float  @default(1)
  sort           Int    @default(0)

  users User[]
}

model AdminUser {
  id           String    @id @default(cuid())
  account      String    @unique
  passwordHash String
  displayName  String
  role         AdminRole @default(CS)
  status       String    @default("ACTIVE")
  failCount    Int       @default(0)
  lockedUntil  DateTime? @db.Timestamptz(3)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  logs OperationLog[]
}

model OperationLog {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String
  action     String
  targetType String
  targetId   String
  beforeJson Json?
  afterJson  Json?
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor AdminUser @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([targetType, targetId])
}

// 单商家自营：只有一行配置，无 merchant / settlement 表
model ShopConfig {
  id                 String  @id @default("singleton")
  shopName           String  @default("山野")
  intro              String?
  logoKey            String?
  servicePhone       String?
  freeThresholdCents Int     @default(9900)
  flatFreightCents   Int     @default(1000)
  payTimeoutMinutes  Int     @default(15)
  afterSaleDays      Int     @default(7)
  autoConfirmDays    Int     @default(10)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

model ShippingRegionException {
  id          String @id @default(cuid())
  regionName  String
  freightCents Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

model Asset {
  id       String   @id @default(cuid())
  key      String   @unique
  url      String
  size     Int      @default(0)
  mimeType String?
  group    String   @default("default")
  refCount Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

// 对外集成参数：小程序登录、微信支付、订阅消息、业务域名
// AppSecret 直接存文本（接口不回传）；支付密钥/证书存服务端文件路径
model IntegrationConfig {
  id                      String   @id @default("singleton")
  // 小程序登录
  miniappAppId            String?
  miniappAppSecret        String?
  // 小程序代码上传密钥（miniprogram-ci 使用）
  miniappUploadKeyFile    String?
  miniappUploadKeyName    String?
  // 支付渠道与微信支付参数
  paymentProvider         String   @default("mock")
  wechatPayMchId          String?
  wechatPayCertSerial     String?
  wechatPayNotifyUrl      String?
  wechatPayApiV3KeyFile   String?
  wechatPayApiV3KeyName   String?
  wechatPayPrivateKeyFile String?
  wechatPayPrivateKeyName String?
  // 订阅消息模板：{ orderPaid, orderShipped, refundResult }
  subscribeTemplateIds    Json?
  // 小程序业务域名 / 服务端 API 地址
  apiBaseUrl              String?
  businessDomain          String?
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
}

// 小程序发布记录：服务器构建 → miniprogram-ci 上传开发版 → 生成体验版二维码
// 审核与发布在微信公众平台完成，这里记录结果供团队追踪
model MiniappRelease {
  id           String   @id @default(cuid())
  version      String
  description  String
  // BUILDING | UPLOADED | FAILED | RELEASED
  status       String   @default("BUILDING")
  qrCodePath   String?
  size         Int      @default(0)
  log          String?  @db.Text
  operatorId   String?
  operatorName String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}

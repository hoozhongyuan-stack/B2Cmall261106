{
  "name": "@shanye/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @shanye/shared build && nest start --watch",
    "build": "pnpm --filter @shanye/shared build && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-search": "tsx prisma/backfill-search-text.ts",
    "db:bench-seed": "tsx prisma/seed-search-benchmark.ts",
    "db:bench-clean": "tsx prisma/seed-search-benchmark.ts --clean",
    "search:bench": "tsx prisma/bench-search.ts",
    "db:demo-reset": "prisma migrate reset --force --skip-generate --skip-seed && pnpm db:seed",
    "db:studio": "prisma studio",
    "test:contract": "vitest run --config ../../vitest.contract.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.17.0",
    "@shanye/shared": "workspace:*",
    "@shanye/tokens": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "miniprogram-ci": "^2.1.31",
    "pinyin-pro": "^3.29.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.6.0",
    "@types/supertest": "^6.0.3",
    "js-yaml": "^4.1.0",
    "openapi-response-validator": "^12.1.3",
    "prisma": "^6.17.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
{
  "name": "shanye-mall",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter @shanye/shared build && pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "ci": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build:api",
    "build:api": "pnpm --filter @shanye/api build",
    "prepare:types": "pnpm --filter @shanye/shared build && pnpm --filter @shanye/api exec prisma generate"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}